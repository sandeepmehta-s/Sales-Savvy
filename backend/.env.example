# Copy this file to .env for local development — DO NOT commit .env

# MongoDB (local development)
MONGODB_URI=mongodb://localhost:27017/shopsphere

# JWT
JWT_SECRET=your-base64-secret-min-32-characters
JWT_EXPIRATION=86400000

# Stripe (test keys — get from dashboard.stripe.com)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# CORS — comma-separated list of allowed origins
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Admin seeder
ADMIN_PASSWORD=StrongAdmin123