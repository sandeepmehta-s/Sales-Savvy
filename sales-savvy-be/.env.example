# Copy this to .env for local development
DB_URL=jdbc:mysql://localhost:3306/ecom?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=your_local_password

RAZORPAY_KEY_ID=rzp_test_yourkey
RAZORPAY_KEY_SECRET=your_secret

JWT_SECRET=your_base64_encoded_secret_min_32_chars
JWT_EXPIRATION=86400000

ADMIN_PASSWORD=StrongAdmin123

# For production — set to frontend Render URL:
# CORS_ALLOWED_ORIGINS=https://sales-savvy-frontend.onrender.com
CORS_ALLOWED_ORIGINS=http://localhost:5173